{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/player_reply.schema.json",
  "title": "PlayerReply",
  "type": "object",
  "required": [
    "game_id",
    "player_id",
    "schema_version",
    "intent",
    "content"
  ],
  "properties": {
    "game_id": { "type": "string", "minLength": 1 },
    "player_id": { "type": "string", "minLength": 1 },
    "schema_version": { "type": "string", "minLength": 1 },
    "intent": {
      "type": "string",
      "enum": ["speak", "vote", "night_action"]
    },
    "content": {
      "type": "object",
      "properties": {
        "speech": { "type": "string" },
        "target": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
